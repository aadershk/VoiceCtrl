{
  "name": "voicectrl-ui",
  "private": true,
  "version": "4.0.0",
  "description": "Every VoiceCtrl surface (Hub, Setup, tray flyout, Overlay) as HTML/CSS for WebView2.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
