<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- ed25519 for the signed update manifest (spec §9): managed code, no native dependency. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- MP3 encoding for the online upload. Ships native libmp3lame binaries per-RID; the
         self-contained win-x64 publish is the thing to check when upgrading it. -->
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <!-- Offline/local transcription (Parakeet-TDT). win-x64 runtime pulled in transitively. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.5" />
    <!-- DPAPI for secrets.bin (spec §5.2). Referenced explicitly rather than relying on the
         Windows Desktop shared framework, so Core keeps it when it stops using WPF. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The built-in vocabulary (ticket 36b), written by tools/vocabulary/build_vocabulary.py. -->
    <EmbeddedResource Include="Vocabulary\terms.txt.gz" LogicalName="VoiceCtrl.Vocabulary.terms.txt.gz" />
    <EmbeddedResource Include="Vocabulary\everyday-words.txt.gz" LogicalName="VoiceCtrl.Vocabulary.everyday-words.txt.gz" />
    <!-- Ticket 60: a 2 s clip of three spoken digits, which tells an Other model that hears audio from one that can't. -->
    <EmbeddedResource Include="Online\probe-digits.wav" LogicalName="VoiceCtrl.Online.probe-digits.wav" />
  </ItemGroup>

</Project>
