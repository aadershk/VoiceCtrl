<Window x:Class="VoiceCtrl.Bootstrap.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceCtrl Setup"
        Width="480" Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Closing="Window_Closing">
    <Grid Margin="28">

        <!-- Mode panel -->
        <StackPanel x:Name="ModePanel" VerticalAlignment="Center">
            <TextBlock Text="Welcome to VoiceCtrl" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,24" Foreground="#FF555555"
                       Text="Choose how VoiceCtrl should transcribe your speech. You can change this any time from the tray icon."/>

            <Button x:Name="OnlineCard" Click="OnOnlineCardClicked" Padding="16" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Online (recommended)" FontWeight="Bold" FontSize="15"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Best accuracy, using Google Gemini. Needs a free API key and an internet connection."/>
                </StackPanel>
            </Button>

            <Button x:Name="OfflineCard" Click="OnOfflineCardClicked" Padding="16" HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Offline" FontWeight="Bold" FontSize="15"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Runs entirely on this PC. No account, no internet, nothing ever leaves your machine. Downloads a one-time ~700MB speech model."/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Online panel -->
        <StackPanel x:Name="OnlinePanel" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Connect your free Gemini API key" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#FF555555"
                       Text="Google AI Studio gives every account a free API key. Get yours, then paste it below."/>

            <Button x:Name="OpenApiKeyPageButton" Content="Get a free API key at Google AI Studio &#8594;"
                    Click="OnOpenApiKeyPageClicked" HorizontalAlignment="Left" Margin="0,0,0,16" Padding="10,6"/>

            <TextBlock Text="API key" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ApiKeyBox" Padding="8" FontSize="14" PasswordChanged="OnApiKeyChanged"/>
            <TextBlock x:Name="OnlineStatusText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <TextBlock TextWrapping="Wrap" Margin="0,16,0,0" FontSize="11" Foreground="#FF888888"
                       Text="Don't have one yet? You can skip this and add a key later from the tray icon's Settings menu."/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Back" Click="OnBackToModeClicked" Padding="12,6"/>
                <Button Grid.Column="2" Content="Skip for now" Click="OnOnlineSkipClicked" Margin="0,0,8,0" Padding="12,6"/>
                <Button x:Name="OnlineContinueButton" Grid.Column="3" Content="Continue" Click="OnOnlineContinueClicked" Padding="16,6"/>
            </Grid>
        </StackPanel>

        <!-- Offline panel -->
        <StackPanel x:Name="OfflinePanel" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Setting up offline mode" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#FF555555"
                       Text="Downloading the speech model. This happens once and needs no further attention."/>

            <ProgressBar x:Name="DownloadProgressBar" Height="18" Minimum="0" Maximum="100" Value="0"/>
            <TextBlock x:Name="OfflineStatusText" Text="Starting download..." Margin="0,8,0,0"/>
            <TextBlock x:Name="OfflineErrorText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#FFB00020" Visibility="Collapsed"/>

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Back" Click="OnBackToModeClicked" Padding="12,6"/>
                <Button x:Name="OfflineRetryButton" Grid.Column="2" Content="Retry" Click="OnOfflineRetryClicked" Margin="0,0,8,0" Padding="12,6" Visibility="Collapsed"/>
                <Button x:Name="OfflineSkipButton" Grid.Column="3" Content="Skip for now" Click="OnOfflineSkipClicked" Margin="0,0,8,0" Padding="12,6"/>
                <Button x:Name="OfflineContinueButton" Grid.Column="4" Content="Continue" Click="OnOfflineContinueClicked" Padding="16,6" IsEnabled="False"/>
            </Grid>
        </StackPanel>

        <!-- Finish panel -->
        <StackPanel x:Name="FinishPanel" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="You're all set" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                Double-tap either <Run FontWeight="Bold">Ctrl</Run> key anywhere to start dictating, and double-tap again to stop. Press <Run FontWeight="Bold">Esc</Run> to cancel a recording.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF555555"
                       Text="Find VoiceCtrl any time in the system tray, near the clock."/>

            <Button x:Name="GetStartedButton" Content="Get started" Click="OnGetStartedClicked" HorizontalAlignment="Right" Margin="0,32,0,0" Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>
