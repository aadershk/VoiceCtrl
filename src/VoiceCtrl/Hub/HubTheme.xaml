        <LineGeometry StartPoint="20,21" EndPoint="20,16"/>
        <LineGeometry StartPoint="20,12" EndPoint="20,3"/>
        <LineGeometry StartPoint="1,14" EndPoint="7,14"/>
        <LineGeometry StartPoint="9,8" EndPoint="15,8"/>
        <LineGeometry StartPoint="17,16" EndPoint="23,16"/>
