    <GeometryGroup x:Key="Icon.Sliders">
        <LineGeometry StartPoint="4,21" EndPoint="4,14"/>
        <LineGeometry StartPoint="4,10" EndPoint="4,3"/>
        <LineGeometry StartPoint="12,21" EndPoint="12,12"/>
