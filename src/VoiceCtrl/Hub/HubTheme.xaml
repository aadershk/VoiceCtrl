<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The "Quiet Ledger" visual language locked in on
        .scratch/hub-ui-refresh/issues/02-design-hub-window.md: flat, hairline-divided, no cards,
        no dark surfaces. IBM Plex Sans/Mono are embedded under Assets/Fonts (SIL OFL 1.1, see
        Assets/Fonts/OFL.txt) rather than fetched from Google Fonts, since the Hub has no network
        dependency otherwise. Every screen the Hub ever gains should pull its palette, type, and
        icons from here rather than redefining them locally.
    -->

    <FontFamily x:Key="PlexSansFamily">pack://application:,,,/VoiceCtrl;component/Assets/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="PlexMonoFamily">pack://application:,,,/VoiceCtrl;component/Assets/Fonts/#IBM Plex Mono</FontFamily>

    <SolidColorBrush x:Key="HubBgBrush" Color="#F1F2F6"/>
    <SolidColorBrush x:Key="HubPanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HubBorderBrush" Color="#DFE0E6"/>
    <SolidColorBrush x:Key="HubBorderStrongBrush" Color="#C9CAD2"/>
    <SolidColorBrush x:Key="HubInkBrush" Color="#16171C"/>
    <SolidColorBrush x:Key="HubInkDimBrush" Color="#63656F"/>
    <SolidColorBrush x:Key="HubInkFaintBrush" Color="#9799A2"/>
    <SolidColorBrush x:Key="HubAccentBrush" Color="#F0472B"/>
    <SolidColorBrush x:Key="HubCloseHoverBrush" Color="#E0463A"/>
    <SolidColorBrush x:Key="HubNavActiveTintBrush" Color="#0DF0472B"/>
    <SolidColorBrush x:Key="HubDangerBrush" Color="#B3271A"/>
    <SolidColorBrush x:Key="HubWarningBgBrush" Color="#FDF3E7"/>
    <SolidColorBrush x:Key="HubWarningBorderBrush" Color="#EECFA0"/>
    <SolidColorBrush x:Key="HubWarningInkBrush" Color="#7A5313"/>
    <SolidColorBrush x:Key="HubWarningIconBrush" Color="#C98A1F"/>

    <!-- ============ Feather icons (github.com/feathericons/feather, MIT), 24x24 viewBox ============ -->

