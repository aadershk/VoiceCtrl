    <GeometryGroup x:Key="Icon.AlertTriangle">
        <PathGeometry Figures="M12,2 L1,21 L23,21 Z"/>
        <LineGeometry StartPoint="12,9" EndPoint="12,13"/>
        <EllipseGeometry Center="12,17" RadiusX="0.15" RadiusY="0.15"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.RefreshCw">
        <PathGeometry Figures="M23,4 L23,10 L17,10"/>
        <PathGeometry Figures="M1,20 L1,14 L7,14"/>
        <PathGeometry Figures="M3.51,9 A9,9 0 0 1 20.49,6.51 L23,10 M1,14 L3.51,17.49 A9,9 0 0 0 20.49,15"/>
    </GeometryGroup>

    <!-- ============ Titlebar window-control buttons ============ -->

    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource HubInkFaintBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PlexSansFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HubBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HubCloseHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Sidebar nav item ============ -->

    <Style x:Key="NavItemStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="HubNav"/>
        <Setter Property="Padding" Value="15,10"/>
        <Setter Property="Foreground" Value="{StaticResource HubInkDimBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PlexSansFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" BorderThickness="2,0,0,0" BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="TextElement.Foreground" Value="{StaticResource HubInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource HubAccentBrush}"/>
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HubNavActiveTintBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource HubInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Dictations row (ticket 06) — reusable pattern for later editor screens ============ -->

    <Style x:Key="DictationRowStyle" TargetType="Border">
        <Setter Property="Margin" Value="20,0,20,6"/>
        <Setter Property="Padding" Value="16,13"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HubPanelBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource HubBorderBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HubIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{StaticResource HubPanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HubInkFaintBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource HubAccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource HubAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubIconButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource HubIconButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource HubBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource HubDangerBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource HubDangerBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Primary/text action buttons (ticket 07) — for "Add entry"-style header
         actions and per-row Edit/Remove text buttons on later editor screens ============ -->

    <Style x:Key="HubPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Background" Value="{StaticResource HubInkBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource PlexSansFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2B2C33"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HubBorderStrongBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource HubInkFaintBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubTextButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource HubInkDimBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PlexSansFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource HubInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubTextButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource HubTextButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource HubDangerBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Settings screen (ticket 11): subtabs, toggle switch, key-picker pills ============ -->

    <Style x:Key="HubSubtabStyle" TargetType="RadioButton">
        <Setter Property="Padding" Value="4,8"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
        <Setter Property="Foreground" Value="{StaticResource HubInkDimBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PlexSansFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource HubInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource HubAccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource HubInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A three-way segmented control (Settings > Transcription > Mode). Unlike HubPillButtonStyle's
         many-simultaneous-states case, Mode is always exactly one of three, so a plain IsChecked
         trigger is enough. -->
    <Style x:Key="HubSegmentButtonStyle" TargetType="RadioButton">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="{StaticResource HubPanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HubInkDimBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PlexSansFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource HubBorderStrongBrush}" BorderThickness="0,0,1,0">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HubInkBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A pill toggle switch (Trigger Key on/off). Background and thumb position both flip on
         IsChecked; callers needing an "active/selected" look for something other than a bool
         toggle (a key-picker option, a mode switch) use HubPillButtonStyle below instead, since
         those need more than two states and are simplest to recolor per-instance in code, the
         same way BuildDictionaryRow etc. set Foreground directly rather than via a style trigger. -->
    <Style x:Key="HubToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="10" Background="{StaticResource HubBorderStrongBrush}">
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource HubAccentBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small rounded-rect pill button: a key-picker option, a chord-prefix option, or a mode
         switch option (Single key / Key combination). "Selected"/"excluded" looks are set directly
         on the instance in code (Background/Foreground/strikethrough content), not via triggers,
         since there can be many simultaneously-rendered instances of this in different states. -->
    <Style x:Key="HubPillButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Background" Value="{StaticResource HubPanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HubInkDimBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PlexMonoFamily}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource HubBorderStrongBrush}" BorderThickness="1" CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource HubInkFaintBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dashed capture box for the chord's live-captured second key (Settings > Hotkey). -->
    <Style x:Key="HubCaptureBoxStyle" TargetType="Button">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Background" Value="{StaticResource HubPanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HubInkDimBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PlexMonoFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource HubBorderStrongBrush}"
                            BorderThickness="1.5" CornerRadius="6">
                        <Border.Resources>
                            <Style TargetType="Border">
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                            </Style>
                        </Border.Resources>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Confirmation dialog (delete pattern from ticket 02, round 5) ============ -->

    <Style x:Key="ModalCancelButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Background" Value="{StaticResource HubBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource HubInkBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PlexSansFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource HubBorderStrongBrush}" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource HubInkFaintBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModalDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModalCancelButtonStyle}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource HubDangerBrush}" BorderBrush="{StaticResource HubDangerBrush}" BorderThickness="1" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#CC4536"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
