        <EllipseGeometry Center="12,12" RadiusX="10" RadiusY="10"/>
        <PathGeometry Figures="M12,6 L12,12 L16,14"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.BookOpen">
        <PathGeometry Figures="M2,3 L8,3 A4,4 0 0 1 12,7 L12,21 A3,3 0 0 0 9,18 L2,18 Z"/>
        <PathGeometry Figures="M22,3 L16,3 A4,4 0 0 0 12,7 L12,21 A3,3 0 0 1 15,18 L22,18 Z"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Scissors">
        <EllipseGeometry Center="6,6" RadiusX="3" RadiusY="3"/>
        <EllipseGeometry Center="6,18" RadiusX="3" RadiusY="3"/>
        <LineGeometry StartPoint="20,4" EndPoint="8.12,15.88"/>
        <LineGeometry StartPoint="14.47,14.48" EndPoint="20,20"/>
        <LineGeometry StartPoint="8.12,8.12" EndPoint="12,12"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Grid">
        <RectangleGeometry Rect="3,3,7,7"/>
        <RectangleGeometry Rect="14,3,7,7"/>
        <RectangleGeometry Rect="14,14,7,7"/>
        <RectangleGeometry Rect="3,14,7,7"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Search">
        <EllipseGeometry Center="11,11" RadiusX="8" RadiusY="8"/>
        <LineGeometry StartPoint="21,21" EndPoint="16.65,16.65"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Copy">
        <RectangleGeometry Rect="9,9,13,13" RadiusX="2" RadiusY="2"/>
        <PathGeometry Figures="M5,15 L4,15 A2,2 0 0 1 2,13 L2,4 A2,2 0 0 1 4,2 L13,2 A2,2 0 0 1 15,4 L15,5"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Check">
        <PathGeometry Figures="M20,6 L9,17 L4,12"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Trash2">
        <PathGeometry Figures="M3,6 L5,6 L21,6"/>
        <PathGeometry Figures="M19,6 L19,20 A2,2 0 0 1 17,22 L7,22 A2,2 0 0 1 5,20 L5,6 M8,6 L8,4 A2,2 0 0 1 10,2 L14,2 A2,2 0 0 1 16,4 L16,6"/>
        <LineGeometry StartPoint="10,11" EndPoint="10,17"/>
        <LineGeometry StartPoint="14,11" EndPoint="14,17"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Clipboard">
        <PathGeometry Figures="M16,4 L18,4 A2,2 0 0 1 20,6 L20,20 A2,2 0 0 1 18,22 L6,22 A2,2 0 0 1 4,20 L4,6 A2,2 0 0 1 6,4 L8,4"/>
        <RectangleGeometry Rect="8,2,8,4" RadiusX="1" RadiusY="1"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.X">
        <LineGeometry StartPoint="18,6" EndPoint="6,18"/>
        <LineGeometry StartPoint="6,6" EndPoint="18,18"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.Plus">
        <LineGeometry StartPoint="12,5" EndPoint="12,19"/>
        <LineGeometry StartPoint="5,12" EndPoint="19,12"/>
    </GeometryGroup>

    <PathGeometry x:Key="Icon.Edit2" Figures="M17,3 A2.828,2.828 0 1 1 21,7 L7.5,20.5 L2,22 L3.5,16.5 Z"/>

    <GeometryGroup x:Key="Icon.Eye">
        <PathGeometry Figures="M1,12 A11,7 0 0 1 23,12 A11,7 0 0 1 1,12 Z"/>
        <EllipseGeometry Center="12,12" RadiusX="3" RadiusY="3"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Icon.EyeOff">
        <PathGeometry Figures="M1,12 A11,7 0 0 1 23,12 A11,7 0 0 1 1,12 Z"/>
        <EllipseGeometry Center="12,12" RadiusX="3" RadiusY="3"/>
        <LineGeometry StartPoint="2,2" EndPoint="22,22"/>
