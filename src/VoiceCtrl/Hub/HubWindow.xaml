<Window x:Class="VoiceCtrl.Hub.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:VoiceCtrl.Hub.Controls"
        Title="VoiceCtrl"
        Width="1040" Height="680" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource HubBgBrush}"
        FontFamily="{StaticResource PlexSansFamily}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                             ResizeBorderThickness="6"
                             CornerRadius="0"
                             GlassFrameThickness="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource HubBorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ Titlebar ============ -->
            <Grid Grid.Row="0" Background="{StaticResource HubPanelBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" BorderThickness="0,0,0,1" BorderBrush="{StaticResource HubBorderBrush}"/>
                <TextBlock Grid.Column="0" Text="VoiceCtrl" Margin="14,0,0,0"
                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"
                           Foreground="{StaticResource HubInkDimBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#x2013;" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#x25a1;" Click="MaximizeButton_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}"
                            Content="&#x2715;" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ Body: sidebar + content ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar: always-expanded, no collapse toggle (Quiet Ledger, round 5). -->
                <Border Grid.Column="0" Background="{StaticResource HubPanelBrush}"
                        BorderThickness="0,0,1,0" BorderBrush="{StaticResource HubBorderBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,14,14,10">
                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource HubInkBrush}">
                                <Canvas Width="28" Height="28">
                                    <Rectangle Canvas.Left="8" Canvas.Top="11" Width="2.6" Height="6" RadiusX="1.3" RadiusY="1.3" Fill="{StaticResource HubAccentBrush}"/>
                                    <Rectangle Canvas.Left="12.7" Canvas.Top="7" Width="2.6" Height="14" RadiusX="1.3" RadiusY="1.3" Fill="{StaticResource HubAccentBrush}"/>
                                    <Rectangle Canvas.Left="17.4" Canvas.Top="9.5" Width="2.6" Height="9" RadiusX="1.3" RadiusY="1.3" Fill="{StaticResource HubAccentBrush}"/>
                                </Canvas>
                            </Border>
                            <TextBlock Text="VoiceCtrl" Margin="9,0,0,0" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource HubInkBrush}"/>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource HubBorderBrush}">
                            <TextBlock x:Name="VersionText" Margin="14,12,14,16" FontSize="11"
                                       Foreground="{StaticResource HubInkFaintBrush}"/>
                        </Border>

                        <StackPanel Margin="0,8,0,0">
                            <RadioButton x:Name="DictationsNavButton" Style="{StaticResource NavItemStyle}"
                                         Checked="NavButton_Checked" Tag="Dictations">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FeatherIcon Data="{StaticResource Icon.Clock}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"/>
                                    <TextBlock Text="Dictations" Margin="12,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DictionaryNavButton" Style="{StaticResource NavItemStyle}"
                                         Checked="NavButton_Checked" Tag="Dictionary">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FeatherIcon Data="{StaticResource Icon.BookOpen}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"/>
                                    <TextBlock Text="Dictionary" Margin="12,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SnippetsNavButton" Style="{StaticResource NavItemStyle}"
                                         Checked="NavButton_Checked" Tag="Snippets">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FeatherIcon Data="{StaticResource Icon.Scissors}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"/>
                                    <TextBlock Text="Snippets" Margin="12,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ProfilesNavButton" Style="{StaticResource NavItemStyle}"
                                         Checked="NavButton_Checked" Tag="Profiles">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FeatherIcon Data="{StaticResource Icon.Grid}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"/>
                                    <TextBlock Text="Profiles" Margin="12,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SettingsNavButton" Style="{StaticResource NavItemStyle}"
                                         Checked="NavButton_Checked" Tag="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FeatherIcon Data="{StaticResource Icon.Sliders}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"/>
                                    <TextBlock Text="Settings" Margin="12,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content: one panel per section, wired up in tickets 06 (Dictations), 07
                     (Dictionary), 08 (Snippets), and 09 (Profiles). -->
                <Grid Grid.Column="1">
                    <Grid x:Name="DictationsPanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="30,20,30,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <TextBlock Text="Dictations" FontSize="19" FontWeight="Bold" Foreground="{StaticResource HubInkBrush}"/>
                                <TextBlock Text="Last 50 Dictations. Text and timestamp only." Margin="0,4,0,0"
                                           FontSize="12.5" Foreground="{StaticResource HubInkDimBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Bottom" MinWidth="180"
                                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource HubBorderStrongBrush}" Padding="0,0,0,6">
                                <Grid>
                                    <DockPanel LastChildFill="True">
                                        <controls:FeatherIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Search}"
                                                               Stroke="{StaticResource HubInkFaintBrush}" Size="14" Margin="0,0,7,0"/>
                                        <TextBox x:Name="DictationsSearchBox" Background="Transparent" BorderThickness="0"
                                                 FontFamily="{StaticResource PlexSansFamily}" FontSize="12.5"
                                                 Foreground="{StaticResource HubInkBrush}" CaretBrush="{StaticResource HubInkBrush}"
                                                 TextChanged="DictationsSearchBox_TextChanged"/>
                                    </DockPanel>
                                    <TextBlock x:Name="DictationsSearchPlaceholder" Text="Search Dictations" Margin="21,0,0,0"
                                               IsHitTestVisible="False" FontSize="12.5" Foreground="{StaticResource HubInkFaintBrush}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DictationsListPanel" Margin="0,0,0,16"/>
                            </ScrollViewer>
                            <TextBlock x:Name="DictationsEmptyText" Text="Nothing to show yet." HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{StaticResource HubInkFaintBrush}"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="DictionaryPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="30,20,30,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Dictionary" FontSize="19" FontWeight="Bold" Foreground="{StaticResource HubInkBrush}"/>
                                    <TextBlock x:Name="DictionaryCountText" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                                               FontFamily="{StaticResource PlexMonoFamily}" Foreground="{StaticResource HubInkFaintBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Names, jargon, and product spellings used to correct Transcriptions." Margin="0,4,0,0"
                                           FontSize="12.5" Foreground="{StaticResource HubInkDimBrush}"/>
                            </StackPanel>
                            <Button x:Name="AddDictionaryButton" Grid.Column="1" VerticalAlignment="Bottom"
                                    Style="{StaticResource HubPrimaryButtonStyle}" Click="AddDictionaryButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FeatherIcon Data="{StaticResource Icon.Plus}" Stroke="White" Size="13"/>
                                    <TextBlock Text="Add entry" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DictionaryListPanel" Margin="0,0,0,16"/>
                            </ScrollViewer>
                            <TextBlock x:Name="DictionaryEmptyText" Text="Nothing to show yet." HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{StaticResource HubInkFaintBrush}"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="SnippetsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="30,20,30,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Snippets" FontSize="19" FontWeight="Bold" Foreground="{StaticResource HubInkBrush}"/>
                                    <TextBlock x:Name="SnippetsCountText" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                                               FontFamily="{StaticResource PlexMonoFamily}" Foreground="{StaticResource HubInkFaintBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Spoken shorthand that expands during cleanup." Margin="0,4,0,0"
                                           FontSize="12.5" Foreground="{StaticResource HubInkDimBrush}"/>
                            </StackPanel>
                            <Button x:Name="AddSnippetButton" Grid.Column="1" VerticalAlignment="Bottom"
                                    Style="{StaticResource HubPrimaryButtonStyle}" Click="AddSnippetButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FeatherIcon Data="{StaticResource Icon.Plus}" Stroke="White" Size="13"/>
                                    <TextBlock Text="Add snippet" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SnippetsListPanel" Margin="0,0,0,16"/>
                            </ScrollViewer>
                            <TextBlock x:Name="SnippetsEmptyText" Text="Nothing to show yet." HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{StaticResource HubInkFaintBrush}"/>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ProfilesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="30,20,30,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Profiles" FontSize="19" FontWeight="Bold" Foreground="{StaticResource HubInkBrush}"/>
                                    <TextBlock x:Name="ProfilesCountText" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                                               FontFamily="{StaticResource PlexMonoFamily}" Foreground="{StaticResource HubInkFaintBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Per-app Tone, Formatting, and Cleanup Level overrides. An app with no Profile uses built-in behavior." Margin="0,4,0,0"
                                           FontSize="12.5" Foreground="{StaticResource HubInkDimBrush}"/>
                                <TextBlock Text="Only applied in Online transcription Mode. Offline mode ignores Tone/Formatting/Cleanup Level." Margin="0,2,0,0"
                                           FontSize="12.5" Foreground="{StaticResource HubInkFaintBrush}"/>
                            </StackPanel>
                            <Button x:Name="AddProfileButton" Grid.Column="1" VerticalAlignment="Bottom"
                                    Style="{StaticResource HubPrimaryButtonStyle}" Click="AddProfileButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FeatherIcon Data="{StaticResource Icon.Plus}" Stroke="White" Size="13"/>
                                    <TextBlock Text="Add profile" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ProfilesListPanel" Margin="0,0,0,16"/>
                            </ScrollViewer>
                            <TextBlock x:Name="ProfilesEmptyText" Text="Nothing to show yet." HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{StaticResource HubInkFaintBrush}"/>
                        </Grid>
                    </Grid>

                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="30,20,30,14">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Settings" FontSize="19" FontWeight="Bold" Foreground="{StaticResource HubInkBrush}"/>
                                <TextBlock Text="App-wide configuration." Margin="0,4,0,0"
                                           FontSize="12.5" Foreground="{StaticResource HubInkDimBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{StaticResource HubBorderBrush}" Padding="30,0,30,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HotkeySubtabButton" Style="{StaticResource HubSubtabStyle}"
                                             GroupName="SettingsSubtab" Content="Hotkey"
                                             Checked="SettingsSubtab_Checked" Tag="Hotkey"/>
                                <RadioButton x:Name="TranscriptionSubtabButton" Style="{StaticResource HubSubtabStyle}"
                                             GroupName="SettingsSubtab" Content="Transcription"
                                             Checked="SettingsSubtab_Checked" Tag="Transcription"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <!-- Built entirely in code-behind (RefreshHotkeyPanel), same pattern as
                                     DictionaryListPanel/SnippetsListPanel/ProfilesListPanel: too much of
                                     this is conditional (an open key picker, Trigger Key on/off, single-key
                                     vs. chord, live warnings) to express cleanly as static XAML. -->
                                <StackPanel x:Name="HotkeySubtabPanel" Visibility="Visible"/>

                                <StackPanel x:Name="TranscriptionSubtabPanel" Visibility="Collapsed">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource HubBorderBrush}" Padding="30,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                <TextBlock Text="Mode" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HubInkBrush}"/>
                                                <TextBlock Text="Which transcription backend a Dictation uses." Margin="0,3,0,0"
                                                           FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource HubInkFaintBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" HorizontalAlignment="Right" BorderThickness="1" CornerRadius="6"
                                                    BorderBrush="{StaticResource HubBorderStrongBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="ModeAutoButton" Style="{StaticResource HubSegmentButtonStyle}"
                                                                 GroupName="TranscriptionMode" Content="Auto" Tag="Auto" Checked="ModeButton_Checked"/>
                                                    <RadioButton x:Name="ModeOnlineButton" Style="{StaticResource HubSegmentButtonStyle}"
                                                                 GroupName="TranscriptionMode" Content="Online" Tag="Online" Checked="ModeButton_Checked"/>
                                                    <RadioButton x:Name="ModeOfflineButton" Style="{StaticResource HubSegmentButtonStyle}"
                                                                 GroupName="TranscriptionMode" Content="Offline" Tag="Offline" Checked="ModeButton_Checked"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource HubBorderBrush}" Padding="30,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                <TextBlock Text="Gemini API key" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HubInkBrush}"/>
                                                <TextBlock Text="Used for Online/Auto Mode." Margin="0,3,0,0"
                                                           FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource HubInkFaintBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" MaxWidth="380">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" VerticalAlignment="Bottom">
                                                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                                                     FontFamily="{StaticResource PlexMonoFamily}" FontSize="13"
                                                                     Background="Transparent" BorderThickness="0,0,0,1"
                                                                     BorderBrush="{StaticResource HubBorderStrongBrush}" Padding="0,0,0,4"
                                                                     CaretBrush="{StaticResource HubInkBrush}" Foreground="{StaticResource HubInkBrush}"
                                                                     PasswordChanged="ApiKeyPasswordBox_PasswordChanged"
                                                                     PreviewKeyDown="ApiKeyBox_PreviewKeyDown"/>
                                                        <TextBox x:Name="ApiKeyTextBox" Visibility="Collapsed"
                                                                 FontFamily="{StaticResource PlexMonoFamily}" FontSize="13"
                                                                 Background="Transparent" BorderThickness="0,0,0,1"
                                                                 BorderBrush="{StaticResource HubBorderStrongBrush}" Padding="0,0,0,4"
                                                                 CaretBrush="{StaticResource HubInkBrush}" Foreground="{StaticResource HubInkBrush}"
                                                                 TextChanged="ApiKeyTextBox_TextChanged"
                                                                 PreviewKeyDown="ApiKeyBox_PreviewKeyDown"/>
                                                    </Grid>
                                                    <Button x:Name="ApiKeyEyeButton" Grid.Column="1" Style="{StaticResource HubIconButtonStyle}"
                                                            Margin="6,0,0,0" Click="ApiKeyEyeButton_Click" ToolTip="Show/hide key">
                                                        <controls:FeatherIcon x:Name="ApiKeyEyeIcon" Data="{StaticResource Icon.Eye}" Size="14"
                                                                               Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                                    </Button>
                                                    <Button x:Name="ApiKeySaveButton" Grid.Column="2" Style="{StaticResource HubPrimaryButtonStyle}"
                                                            Content="Save" Margin="6,0,0,0" Click="ApiKeySaveButton_Click"/>
                                                </Grid>
                                                <TextBlock x:Name="ApiKeyStatusText" Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                                                           HorizontalAlignment="Right" TextAlignment="Right" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="ApiKeyRestartBanner" Margin="30,14,30,0" Padding="12,10" CornerRadius="8"
                                            BorderThickness="1" BorderBrush="{StaticResource HubBorderBrush}" Background="{StaticResource HubBgBrush}"
                                            Visibility="Collapsed">
                                        <DockPanel LastChildFill="True">
                                            <controls:FeatherIcon DockPanel.Dock="Left" Data="{StaticResource Icon.RefreshCw}" Size="14"
                                                                   Stroke="{StaticResource HubInkFaintBrush}" Margin="0,1,9,0" VerticalAlignment="Top"/>
                                            <TextBlock Text="Restart VoiceCtrl for the new key to take effect: right-click the tray icon, click Quit, then reopen VoiceCtrl."
                                                       FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource HubInkDimBrush}"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Reusable delete-confirmation overlay (Quiet Ledger pattern, ticket 02)
                         shared by every section; whichever ticket needs it sets ConfirmDialogTitleText
                         and a pending action, then flips this to Visible. -->
                    <Border x:Name="ConfirmDialogOverlay" Background="#52141420" Visibility="Collapsed">
                        <Border Width="360" MaxWidth="480" Background="{StaticResource HubPanelBrush}" CornerRadius="12"
                                Padding="20,20,22,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#14141E" BlurRadius="60" ShadowDepth="18" Opacity="0.28" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="ConfirmDialogTitleText" Text="Are you sure?" FontSize="15" FontWeight="Bold"
                                               TextWrapping="Wrap" Foreground="{StaticResource HubInkBrush}" Margin="0,0,24,0"/>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" Padding="0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Click="ConfirmDialogCancel_Click">
                                        <controls:FeatherIcon Data="{StaticResource Icon.X}" Stroke="{StaticResource HubInkFaintBrush}" Size="16"/>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Once deleted it cannot be recovered." Margin="0,8,0,20" FontSize="12.5"
                                           Foreground="{StaticResource HubInkDimBrush}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Style="{StaticResource ModalCancelButtonStyle}"
                                            Click="ConfirmDialogCancel_Click" Margin="0,0,10,0"/>
                                    <Button Content="Yes, delete it" Style="{StaticResource ModalDangerButtonStyle}"
                                            Click="ConfirmDialogConfirm_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
