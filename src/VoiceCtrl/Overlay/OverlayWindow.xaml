<Window x:Class="VoiceCtrl.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceCtrl"
        Width="220" Height="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <!-- Edge Sliver (ticket 17): a bottom-edge-flush tab, not a floating capsule. The window
         itself is fixed-size and positioned with zero bottom margin (see MonitorPositioner call
         in ShowBar) so this Grid's bottom edge sits exactly on the work-area edge; everything
         above the sliver is transparent, reserved for the status line and the widen/lift on
         Recording/Processing. -->
    <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Visibility="Hidden" (not Collapsed) reserves layout space either way, so this never
             changes the panel's measured size and can't reintroduce a show-then-jump flicker. -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="0"
                   Margin="8,0,8,8"
                   FontSize="11"
                   Foreground="#FFD0D0D0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="200"
                   TextWrapping="Wrap"
                   Visibility="Hidden"/>

        <Border x:Name="SliverBorder"
                Grid.Row="1"
                Background="#F0171A24"
                BorderBrush="#FF2A2F3D"
                BorderThickness="1,1,1,0"
                CornerRadius="10,10,0,0"
                Padding="14,7,14,5"
                MinWidth="84"
                HorizontalAlignment="Center"
                Cursor="Hand"
                ToolTip="Click to start/stop, double-tap Ctrl to hide"
                MouseLeftButtonUp="SliverBorder_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.4" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="SliverLift" Y="0"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="MicDot" Width="16" Height="16" IsHitTestVisible="False">
                    <!-- Sits behind the mic dot and grows with microphone level. At scale 1 it is
                         exactly covered by the dot, so silence shows nothing at all. -->
                    <Ellipse x:Name="LevelEllipse"
                             IsHitTestVisible="False"
                             Visibility="Hidden"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#66F0472B" Offset="0"/>
                                <GradientStop Color="#00F0472B" Offset="0.68"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="LevelScale" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="MicEllipse" Fill="#FF8D93A3"/>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="9,0,0,0" IsHitTestVisible="False">
                    <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF8D93A3" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                    <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF8D93A3" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                    <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF8D93A3" Margin="0,0,3,0" VerticalAlignment="Bottom"/>
                    <Rectangle x:Name="Bar4" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF8D93A3" VerticalAlignment="Bottom"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
