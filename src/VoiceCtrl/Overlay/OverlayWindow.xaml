<Window x:Class="VoiceCtrl.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceCtrl"
        Width="200" Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="#F2202020" CornerRadius="24" Padding="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid x:Name="MicArea"
                  Width="48" Height="48"
                  Cursor="Hand"
                  ToolTip="Click to start or stop dictation"
                  MouseLeftButtonUp="MicArea_MouseLeftButtonUp">
                <Ellipse x:Name="MicEllipse" Fill="#FF505050"/>
                <TextBlock Text="&#127908;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <!-- Visibility="Hidden" (not Collapsed) reserves layout space either way, so this
                 never changes the panel's measured size and can't reintroduce the show-then-jump
                 flicker that fixed Width/Height was chosen to avoid. -->
            <TextBlock x:Name="StatusText"
                       Margin="0,6,0,0"
                       FontSize="11"
                       Foreground="#FFD0D0D0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="184"
                       TextWrapping="Wrap"
                       Visibility="Hidden"/>
        </StackPanel>
    </Border>
</Window>
