# VoiceCtrl configuration
# Copy this file to .env and fill in your own Gemini API key.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Optional overrides (defaults shown; safe to leave commented out)
# GEMINI_MODEL_ID=gemini-3.7-flash
# Faster/cheaper experiment: gemini-3.5-flash-lite trades some cleanup quality for lower latency.
# DOUBLE_TAP_WINDOW_MS=400
# AUTO_HIDE_DELAY_MS=1500
# THINKING_LEVEL=low
# DICTATION_STYLE_NOTES=Prefer "that" over "which"; never expand acronyms like API, UI, URL
# ENABLE_TONE_AWARENESS=true
# Structured Markdown (bullets/numbered steps) for prompt/terminal-style apps, plain continuous
# prose for chat apps, auto-detected from the active window. Add process names here (Task
# Manager > Details tab) if the built-in guess for an app is wrong, or to cover more apps.
# PROMPT_STYLE_APPS=claude,cursor
# CHAT_STYLE_APPS=whatsapp,telegram
# CLEANUP_LEVEL=standard
#
# TRANSCRIPTION_MODE=Online
# Only two values are recognized here: Online or Offline. Offline runs a local model, so no audio
# leaves your PC, no API key needed, but cleanup is more limited (see README). Leaving this unset,
# or setting it to Online, both enable Auto mode at runtime: Gemini is tried first and the app
# transparently falls back to the offline model if there's no network or the request fails. There
# is no literal "Auto" value to set here. Auto is the default behavior, not an explicit mode; to
# force pure Online (no fallback) or switch at runtime, use the tray icon's Mode submenu instead.
# LOCAL_MODEL_VARIANT=parakeet-tdt-0.6b-v2
#
# ONNX threads for the offline model. Defaults to half this machine's logical cores, clamped to
# 2-8. Higher is faster up to a point; past six the gains flatten and the extra threads only
# compete with whatever you are actually working in.
# LOCAL_NUM_THREADS=8
#
# MP3-compress the audio before uploading in Online mode. Cuts the payload to roughly a tenth,
# so the upload is faster, but the effect on transcription accuracy has not been measured against
# the live API. Leave this off unless you have compared transcripts yourself.
# COMPRESS_UPLOAD=false
#
# Offline mode only: turn spoken "comma", "period", "question mark" and friends into the
# characters themselves. Off by default because those are ordinary English words, so "the comma
# is missing" would come out as "the , is missing". Online mode still has the audio when it makes
# this call, so it needs no switch. Spoken "new line" and "new paragraph" work in both modes and
# are always on.
# SPOKEN_PUNCTUATION=false

# Three more files live alongside this one, in %LOCALAPPDATA%\VoiceCtrl, and are created with
# commented examples on first run. Open them from the tray icon under Personalize:
#   dictionary.txt   names and jargon to spell your way
#   snippets.txt     spoken shorthand to expand, as "trigger = expansion"
#   profiles.json    per-application tone, formatting and cleanup overrides
