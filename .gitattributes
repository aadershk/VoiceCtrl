# Store text files with LF in the repo regardless of each machine's core.autocrlf, so
# collaborators on different settings never see whole-file line-ending diffs.
* text=auto

# Generated by tools/BridgeTypegen. Never hand-merge: a merge that touches it on both sides stops
# with a conflict, and the fix is to regenerate it (dotnet run --project tools/BridgeTypegen).
ui/src/bridge/contracts.g.ts linguist-generated=true -merge

# Shell scripts run in Git Bash, which chokes on CRLF.
*.sh text eol=lf
